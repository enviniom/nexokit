func (r *{{.Struct}}Repository) Count(ctx context.Context) (int64, error) {
	var count int64
	q := r.db.WithContext(ctx).Model(&{{.Struct}}{})
	{{- if .Tenant }}
	q = q.Where("company_id = ?", ctx.Value("company_id"))
	{{- end }}
	if err := q.Count(&count).Error; err != nil {
