}

// List returns paginated {{.Table}}.
func (r *{{.Struct}}Repository) List(ctx context.Context, page, perPage int) ([]{{.Struct}}, error) {
	var items []{{.Struct}}
	offset := (page - 1) * perPage
	q := r.db.WithContext(ctx).Limit(perPage).Offset(offset).Order("created_at DESC")
	{{- if .Tenant }}
	q = q.Where("company_id = ?", ctx.Value("company_id"))
	{{- end }}
	if err := q.Find(&items).Error; err != nil {
		return nil, err
	}
	return items, nil
}

