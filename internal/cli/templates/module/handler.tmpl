package {{.UseCase}}

import (
	"github.com/enviniom/nexokit/internal/modules/{{.Name}}/core"
	{{- if ne .Action "delete" }}
	entity "github.com/enviniom/nexokit/internal/modules/{{.Name}}/core/{{.Package}}"
	{{- end }}
	{{- if or (eq .Action "create") (eq .Action "update") }}
	"github.com/enviniom/nexokit/internal/platform/messages"
	{{- end }}
	{{- if eq .Action "list" }}
	"github.com/enviniom/nexokit/internal/platform/query"
	{{- end }}
	"github.com/enviniom/nexokit/internal/platform/response"
	{{- if .Tenant }}
	"github.com/enviniom/nexokit/internal/platform/tenant"
	{{- end }}
	"github.com/gin-gonic/gin"
)

{{if eq .Action "create"}}type Handler struct { repo core.CreateRepository }
func NewHandler(repo core.CreateRepository) *Handler { return &Handler{repo: repo} }
{{else if eq .Action "get"}}type Handler struct { repo core.GetRepository }
func NewHandler(repo core.GetRepository) *Handler { return &Handler{repo: repo} }
{{else if eq .Action "list"}}type Handler struct { repo core.ListRepository }
func NewHandler(repo core.ListRepository) *Handler { return &Handler{repo: repo} }
{{else if eq .Action "update"}}type Handler struct { repo core.UpdateRepository }
func NewHandler(repo core.UpdateRepository) *Handler { return &Handler{repo: repo} }
{{else if eq .Action "delete"}}type Handler struct { repo core.DeleteRepository }
func NewHandler(repo core.DeleteRepository) *Handler { return &Handler{repo: repo} }
{{end}}

func (h *Handler) Handle(c *gin.Context) {
	{{- if .Tenant }}
	tc, ok := tenant.FromGin(c)
	{{- if eq .Action "list" }}
	if !ok || (!tc.IsRootScope && tc.CompanyID == 0) || (tc.IsRootScope && tc.CompanyID != 0) {
	{{- else }}
	if !ok || tc.IsRootScope || tc.CompanyID == 0 {
	{{- end }}
		response.HandleError(c, core.ErrTenantRequired)
		return
	}
	{{- end }}
	{{- if eq .Action "create" }}
	var req entity.Create{{.Struct}}Request
	if err := c.ShouldBindJSON(&req); err != nil {
		response.BadRequest(c, messages.MsgBadRequest)
		return
	}
	if response.RespondIfInvalid(c, req.Validate()) { return }
	m, err := h.repo.Create(c.Request.Context(), {{if .Tenant}}tc, {{end}}&entity.{{.Struct}}{Name: req.Name})
	if err != nil { response.HandleError(c, err); return }
	var dto entity.{{.Struct}}Response
	dto.FromModel(*m)
	response.Created(c, "{{.Struct}} created", dto)
	{{- else if eq .Action "get" }}
	m, err := h.repo.Get(c.Request.Context(), {{if .Tenant}}tc, {{end}}c.Param("id"))
	if err != nil { response.HandleError(c, err); return }
	var dto entity.{{.Struct}}Response
	dto.FromModel(*m)
	response.Success(c, "{{.Struct}} retrieved", dto)
	{{- else if eq .Action "list" }}
	params := query.ListFromGin(c)
	items, total, err := h.repo.List(c.Request.Context(), {{if .Tenant}}tc, {{end}}params)
	if err != nil { response.HandleError(c, err); return }
	dtos := make([]entity.{{.Struct}}Response, len(items))
	for i, m := range items { dtos[i].FromModel(m) }
	response.PaginatedWithFilters(c, "{{.Struct}} list retrieved", dtos, params, total)
	{{- else if eq .Action "update" }}
	var req entity.Update{{.Struct}}Request
	if err := c.ShouldBindJSON(&req); err != nil {
		response.BadRequest(c, messages.MsgBadRequest)
		return
	}
	if response.RespondIfInvalid(c, req.Validate()) { return }
	m, err := h.repo.Update(c.Request.Context(), {{if .Tenant}}tc, {{end}}c.Param("id"), req.Name)
	if err != nil { response.HandleError(c, err); return }
	var dto entity.{{.Struct}}Response
	dto.FromModel(*m)
	response.Success(c, "{{.Struct}} updated", dto)
	{{- else if eq .Action "delete" }}
	if err := h.repo.Delete(c.Request.Context(), {{if .Tenant}}tc, {{end}}c.Param("id")); err != nil {
		response.HandleError(c, err)
		return
	}
	response.NoContent(c)
	{{- end }}
}
