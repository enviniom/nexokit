APP_NAME=nexokit
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexokit
DB_USER=nexokit
DB_PASSWORD=nexokit
DB_SSL_MODE=disable
# DATABASE_URL=

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=3600

CORS_ALLOWED_ORIGINS=*

LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true
LOG_GIN_FILE=logs/gin.log
LOG_ERROR_FILE=logs/error.log

SHUTDOWN_TIMEOUT_SECONDS=30

CACHE_DRIVER=none
