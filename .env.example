APP_NAME=nexokit
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexokit
DB_USER=nexokit
DB_PASSWORD=nexokit
DB_SSL_MODE=disable
# DATABASE_URL=

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=3600

CORS_ALLOWED_ORIGINS=*

LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true
LOG_GIN_FILE=logs/gin.log
LOG_ERROR_FILE=logs/error.log

SHUTDOWN_TIMEOUT_SECONDS=30

CACHE_DRIVER=none

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT_SECONDS=2

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DRIVER=memory
RATE_LIMIT_GLOBAL_RPM=0
RATE_LIMIT_LOGIN_RPM=5
RATE_LIMIT_REFRESH_RPM=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CLEANUP_INTERVAL_MINUTES=5

# Auth
PASETO_KEY=change-me-in-production-32-bytes-key
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7

# Initial root user
ROOT_USER_NAME=Root User
ROOT_USER_EMAIL=root@example.com
ROOT_USER_PASSWORD=ChangeMe123
